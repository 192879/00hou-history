{
  "name": "00hou-history",
  "version": "2.0.0-alpha.3",
  "private": true,
  "type": "module",
  "description": "00后渡劫模拟器 Web/PWA/Android shared game",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs && node tests.mjs",
    "test:e2e": "node scripts/e2e-edge.mjs",
    "test:legacy": "node tests.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:debug": "npm run android:sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
